    principal: Agent,
    resource: Effect,
    context: {
        consent: Bool,
        purpose: String,
        data_label: String
    }
};

action "deploy_release" appliesTo {
    principal: Agent,
    resource: Effect,
    context: {
        consent: Bool,
        purpose: String,
        data_label: String
    }
};
